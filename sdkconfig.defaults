# IndoorWatch - ESP-IDF sdkconfig.defaults
# Target: ESP32 (esp32), placa ESP-WROOM-32
# Sin OTA, sin PSRAM, sin Secure Boot

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_NO_STUB=n

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3

# Bluetooth clásico (para HC-05 SPP por UART y mando GameSir via BT clásico)
CONFIG_BT_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_ACL_CONNECTIONS=4
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=n

# USB Serial-JTAG para consola (disponible en ESP32 con USB-OTG, opcional)
# CONFIG_USB_CDC_ACM=y
